NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/expense-tracker
# Use a long random string (at least 16 characters, 32+ recommended). Never share or commit it.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Frontend URL(s) allowed by CORS. For multiple origins, separate with commas (no trailing slashes).
CLIENT_URL=http://localhost:5173
